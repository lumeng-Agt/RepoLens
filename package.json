{
  "name": "repo-lens",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev:ui": "node scripts/run-framework.mjs dev",
    "dev": "node scripts/with-local-service.mjs scripts/run-framework.mjs dev",
    "test": "node --test data/*.test.mjs scripts/*.test.mjs desktop/*.test.mjs",
    "test:e2e": "playwright test && node scripts/github-browser-integration.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:clean-source": "node scripts/verify-clean-source.mjs",
    "check:startup": "node scripts/check-startup.mjs",
    "benchmark:indexer": "node scripts/benchmark-indexer.mjs",
    "smoke:github": "node scripts/github-live-smoke.mjs",
    "build": "node scripts/run-framework.mjs build",
    "clean": "node scripts/clean.mjs",
    "build:desktop": "node scripts/run-framework.mjs build --mode desktop",
    "package:desktop": "node scripts/package-desktop-verified.mjs",
    "preview:desktop": "npm run build:desktop && electron .",
    "start": "node scripts/with-local-service.mjs scripts/run-framework.mjs preview",
    "lint": "eslint . --max-warnings 0",
    "test:desktop:smoke": "node scripts/desktop-smoke.mjs",
    "postinstall": "node scripts/patch-panel-observer.mjs"
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@dagrejs/dagre": "^3.1.1",
    "@playwright/test": "^1.63.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "22.19.19",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "lucide-react": "^1.31.0",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tree-sitter-wasms": "^0.1.13",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.4",
    "typescript-eslint": "8.59.3",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5"
  },
  "build": {
    "appId": "org.repolens.desktop",
    "productName": "RepoLens",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/security-policy.mjs",
      "desktop/renderer/**/*",
      "data/**/*",
      "scripts/local-server.mjs",
      "scripts/server/**/*",
      "package.json",
      "!**/*.test.*",
      "desktop/model-settings.mjs",
      "desktop/editor-preference.mjs",
      "desktop/renderer-close.mjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "RepoLens-${version}-${arch}-Portable.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "RepoLens-${version}-${arch}-Setup.${ext}"
    },
    "portable": {
      "unpackDirName": true
    },
    "artifactName": "RepoLens-${version}-${arch}-Portable.${ext}"
  },
  "description": "A local-first desktop tool for exploring source repositories.",
  "author": "RepoLens contributors"
}
