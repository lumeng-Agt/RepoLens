{
  "name": "repo-lens",
  "version": "0.1.0",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev:ui": "node scripts/run-framework.mjs dev",
    "dev": "node scripts/with-local-service.mjs scripts/run-framework.mjs dev",
    "test": "node --test data/*.test.mjs scripts/*.test.mjs desktop/*.test.mjs",
    "test:e2e": "playwright test && node scripts/github-browser-integration.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "verify:clean-source": "node scripts/verify-clean-source.mjs",
    "check:startup": "node scripts/check-startup.mjs",
    "benchmark:indexer": "node scripts/benchmark-indexer.mjs",
    "smoke:github": "node scripts/github-live-smoke.mjs",
    "build": "node scripts/run-framework.mjs build",
    "build:desktop": "vite build --config desktop.vite.config.mjs",
    "package:desktop": "node scripts/package-desktop-verified.mjs",
    "preview:desktop": "npm run build:desktop && electron .",
    "start": "node scripts/with-local-service.mjs --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/renderer --ignore-pattern release --ignore-pattern test-results --ignore-pattern playwright-report --ignore-pattern .artifacts",
    "test:desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "typescript": "^5.9.3",
    "web-tree-sitter": "^0.20.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@dagrejs/dagre": "^3.1.1",
    "@hookform/resolvers": "^5.7.1",
    "@playwright/test": "^1.63.0",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "22.19.19",
    "@types/prismjs": "^1.26.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "embla-carousel-react": "^8.6.0",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "input-otp": "^1.4.2",
    "json-rpc-2.0": "1.7.1",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.6.7",
    "raw-body": "3.0.2",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.1",
    "tree-sitter-wasms": "^0.1.13",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vinext": "^1.3.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "fflate": "0.7.5"
  },
  "build": {
    "appId": "org.repolens.desktop",
    "productName": "RepoLens",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.mjs",
      "desktop/preload.cjs",
      "desktop/security-policy.mjs",
      "desktop/renderer/**/*",
      "data/**/*",
      "scripts/local-server.mjs",
      "package.json",
      "!**/*.test.*",
      "desktop/model-settings.mjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "RepoLens-${version}-${arch}-Portable.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "RepoLens-${version}-${arch}-Setup.${ext}"
    },
    "artifactName": "RepoLens-${version}-${arch}-Portable.${ext}"
  },
  "description": "A local-first desktop tool for exploring source repositories.",
  "author": "RepoLens contributors"
}
